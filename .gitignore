# Secrets — never commit
.env
.env.*
!.env.example

# TLS certificates / CA bundles (e.g. the MongoDB CA file) — never commit
*.pem
*.crt
certs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings (machine-specific) — exclude the whole dir
.claude/

# Reference/source material — not part of the deployment, may contain secrets
dma-api.json
sign_server.py

# Local history dumps (scripts/export_history.py)
exports/
