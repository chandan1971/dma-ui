# ===========================================================================
# Copy this file to ".env" for local development, OR set these as Variables
# in your Railway service. NEVER commit a real .env file.
#
# The app REFUSES TO START if any password/secret below is left at its
# placeholder value or is otherwise weak — replace every one with a unique,
# high-entropy value before running. Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ===========================================================================

# --- CoinSwitch DMA credentials (required) ---
# Your DMA API key and the Ed25519 secret key (hex), same values you used
# as `api_key` / `secretKey` in Postman.
DMA_API_KEY=your_dma_api_key_here
DMA_API_SECRET=your_ed25519_secret_hex_here
# Base URL (leave as default unless told otherwise)
DMA_BASE_URL=https://dma.coinswitch.co

# --- Frontend login: ADMIN (can trade) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# --- Frontend login: VIEWER (read-only) ---
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change_this_viewer_password

# --- Session signing key (required) ---
# Generate a strong random value, e.g.:  python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=generate_a_long_random_string
# Optional: session lifetime in seconds (default 43200 = 12h)
# SESSION_MAX_AGE=43200

# --- Trade token (required to enable trading) ---
# A SECOND secret, separate from the admin password. Every write operation
# (place/cancel/close order, set leverage, set margin mode, transfer funds)
# must carry this token. The admin types it into the dashboard to unlock
# trading. If this is unset, ALL write operations are blocked (fail-closed).
# Generate one: python -c "import secrets;print(secrets.token_hex(24))"
TRADE_TOKEN=generate_another_long_random_string

# --- Trading / market defaults (optional) ---
CATEGORY=linear
SETTLE_COIN=USDT
ACCOUNT_TYPE=UNIFIED
# USDT->INR rate for the dashboard's DISPLAY-ONLY currency toggle (default 94).
# Purely cosmetic: nothing sent to the exchange ever uses it.
# INR_RATE=94

# --- Live dashboard poll interval in seconds (optional, default 5) ---
POLL_INTERVAL=5

# --- Order tagging / idempotency (optional, default off) ---
# When on, every created order carries a server-generated orderLinkId tag, so
# after an ambiguous timeout the maybe-placed order can be found in Open Orders
# by its tag (shown in the error message), and the audit log ties local intents
# to exchange records. orderLinkId is a standard Bybit-v5 field, but this
# gateway has deviated from stock v5 before — place ONE small live order with
# this enabled to verify acceptance, then leave it on.
# SEND_ORDER_LINK_ID=1

# --- Trusted reverse-proxy hop count (optional, default 1) ---
# The client IP used for rate limiting is read this many hops from the RIGHT of
# X-Forwarded-For (the hop your own proxy appended — a client cannot forge it).
# Railway alone = 1. If you put an edge proxy IN FRONT of Railway (e.g.
# Cloudflare -> Railway), set this to 2, or per-client rate limiting collapses
# every client into one shared bucket (one attacker could lock everyone out).
# TRUSTED_PROXY_HOPS=1

# --- Dashboard candlestick charts (read-only public market data, optional) ---
# A SEPARATE public host used ONLY for OHLC candles. It never carries the DMA
# key/secret and is isolated from the signed trading client. Default is Bybit's
# public v5 market API.
# MARKET_DATA_BASE_URL=https://api.bybit.com
# Symbols that are ALWAYS servable by the chart endpoint (comma-separated),
# even while the scanner is disabled or warming up. With the scanner running,
# any symbol observed in the venue's live ticker universe also charts — the
# proxy still rejects anything the venue doesn't actually list, so it can't be
# used to fetch arbitrary markets.
# CHART_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Seconds to cache a kline response in-process (coalesces the ~1s chart polling).
# CHART_CACHE_TTL=1

# --- Market Scanner sampler (read-only, optional) ---
# A background task polls the full ticker list — ONE signed read-only request
# per interval regardless of open tabs — and keeps a rolling in-memory history
# so the Scan tab can show 5m/15m/1h changes, volatility and funding drift.
# Interval in seconds (default 10, floor 5).
# SCANNER_SAMPLE_INTERVAL=10
# Kill switch: set to 0 to start no sampler (the Scan tab shows "disabled").
# SCANNER_ENABLED=1

# --- Automated 4h EMA-cross strategy (BTC/ETH/SOL) ---
# STRATEGY_ENABLED=1 runs the loop and serves /api/strategy (signals only).
# STRATEGY_LIVE=1 additionally PLACES limit entries / reduce-only limit exits.
# Without STRATEGY_LIVE every intended order is logged as a dry run.
# STRATEGY_ENABLED=0
# STRATEGY_LIVE=0
# STRATEGY_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# STRATEGY_NOTIONAL=50
# STRATEGY_NOTIONAL_OVERRIDES=BTCUSDT=100
# STRATEGY_LEVERAGE=1
# STRATEGY_CLOSE_DELAY=10

# --- Overall unrealised-PnL tracker (read-only, optional; needs Redis) ---
# A background task samples the account's TOTAL unrealised PnL — one signed
# read-only positions request per interval — and persists the series in Redis
# so the PnL tab can chart it (7d @5s raw, 60d 1-min, 2y 1-hour rollups;
# ~22 MB at full retention, budgeted for Railway's 500 MB Redis).
# On Railway: add the Redis service to the project, then reference it here:
#   REDIS_URL=${{Redis.REDIS_URL}}
# When unset, nothing is sampled and the PnL tab shows "not configured".
# REDIS_URL=
# Sample cadence in seconds (default 5, floor 2).
# UPNL_SAMPLE_INTERVAL=5
# Kill switch: set to 0 to start no sampler even with REDIS_URL set.
# UPNL_ENABLED=1

# --- Execution alerts via Telegram (read-only, opt-in) ---
# A background watcher pushes a Telegram message on each fill / TP-SL / liquidation.
# OFF unless BOTH values below are set. Setup:
#   1) On Telegram, message @BotFather -> /newbot -> copy the bot token.
#   2) Message your new bot once (say "hi") so it can DM you.
#   3) Open https://api.telegram.org/bot<token>/getUpdates and copy "chat":{"id":...}
#      (or message @userinfobot to get your id).
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=123456789
# How often to poll executions (seconds) and how many recent to scan each poll.
# NOTIFY_POLL_INTERVAL=10
# NOTIFY_EXEC_LIMIT=50

# --- MongoDB history store (required) ---
# Trades & closed-PnL history is mirrored into MongoDB by a background sync
# (every SYNC_INTERVAL_SECONDS, default one minute); the dashboard's History
# tab reads ONLY from Mongo. Keep retryWrites=false if the server is AWS
# DocumentDB (it rejects retryable writes); it is harmless on real MongoDB.
MONGO_URI=mongodb://your-mongo-host:27017/?retryWrites=false
# Credentials go here (NOT inside the URI, so they never need URL-escaping).
# Leave both empty only if the URI itself carries credentials.
MONGO_USERNAME=dma_rw_user
MONGO_PASSWORD=change_this_mongo_password
# Database name (collections used: Trades, Closed-PnL)
# MONGO_DB_NAME=DMA-trading
# TLS CA certificate — set exactly ONE of the two options below.
# Option A (file on disk, e.g. local dev): ABSOLUTE PATH to the CA file. Any
# PEM-encoded file works — .pem and .crt are the SAME format, the extension
# does not matter. The file must exist at this path and must NEVER be
# committed (.gitignore covers *.pem/*.crt). Leave unset only for a non-TLS
# local dev instance.
MONGO_TLS_CA_FILE=/absolute/path/to/mongo-ca.crt
# Option B (Railway or any host with no file on disk): paste the ENTIRE cert
# CONTENT ("-----BEGIN CERTIFICATE-----" ... "-----END CERTIFICATE-----")
# into this variable; the app writes it to a private temp file at startup.
# Railway's Variables tab supports multiline values. NOTE: the local .env
# loader is line-based, so use Option A locally.
# MONGO_TLS_CA_PEM=
# How often the history sync runs, in seconds (default 60 = every minute).
# SYNC_INTERVAL_SECONDS=60
# Cold-start backfill depth in days when a collection is empty (default 730).
# SYNC_BACKFILL_DAYS=730

# --- AI intelligence layer (read-only trading coach, optional) ---
# Provider backing the AI tab: mock (default — deterministic rule-based
# analysis, no key, no network), claude, openai, local, gemini. The AI layer
# is READ-ONLY: it analyzes historical trades/journal/risk and can never
# place, modify or cancel an order. Only sanitized trading data is ever sent
# to a provider — never API keys, secrets or cookies.
# AI_PROVIDER=gemini
# AI_API_KEY=your_llm_api_key_here
# Model id ("" = provider default: claude-opus-5 / gpt-4o / gemini-3.6-flash).
# AI_MODEL=
# Base URL override; REQUIRED for AI_PROVIDER=local (any OpenAI-compatible
# server, e.g. Ollama: http://127.0.0.1:11434/v1).
# AI_BASE_URL=
# Max tokens per generation (default 2048) and request timeout in seconds.
# AI_MAX_TOKENS=2048
# AI_TIMEOUT_S=120
# Cost guardrails: LLM calls per minute cap + seconds a generated briefing
# stays cached while the underlying data is unchanged.
# AI_CALLS_PER_MIN=6
# AI_CACHE_TTL_S=600
